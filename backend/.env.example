PORT=4001
# Comma-separated when both a Firebase preview domain and a custom domain are used.
CLIENT_ORIGIN=http://localhost:3001

# Persistence mode. Keep "file" for local development. Set to "firebase" only
# in Cloud Run (or locally with Application Default Credentials configured).
DATA_BACKEND=file
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Local Firebase testing only. Never commit the referenced service-account file.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\the\repository\service-account.json

# Admin login (used by POST /api/auth/login)
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Encrypts health declaration submissions at rest (AES-256-GCM). Must be exactly 32 bytes (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HEALTH_DATA_ENCRYPTION_KEY=replace-with-a-64-char-hex-string
